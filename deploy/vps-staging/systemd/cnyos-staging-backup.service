[Unit]
Description=CNYOS staging logical PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
TimeoutStartSec=15min
MemoryMax=512M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/lock /srv/cnyos-staging/backend/backups
ExecStart=/usr/local/sbin/cnyos-staging-backup backup
