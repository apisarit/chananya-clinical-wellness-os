# Public identifier returned to the patient app; not a secret.
LINE_LIFF_ID=

# LINE Login channel used to verify the LIFF ID token audience.
LINE_LOGIN_CHANNEL_ID=

# LINE Official Account Messaging API. The callback URL is
# https://<patient-origin>/api/line-oa-webhook. The Messaging API and LINE
# Login channels must belong to the same LINE Developers provider so the
# verified user identity resolves consistently. Keep the secret and access
# token in the Functions runtime only.
LINE_MESSAGING_CHANNEL_ID=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_OA_PATIENT_CARD_URL=
LINE_OA_BRAND_NAME=ชนัญญา

# Server-only values. Never copy these into auth-config.js or browser code.
PATIENT_IDENTITY_HMAC_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Immutable UUID binding for this isolated Netlify site/Supabase tenant. Both
# patient identity and LINE OA Functions fail closed when it is missing or the
# clinic subscription is suspended.
CNYOS_RUNTIME_EXPECTED_CLINIC_ID=

# CNYOS platform-owner control plane. Keep the allowlist and service-role key
# in the Functions runtime only. Owner access requires a confirmed Google
# identity whose exact email appears in this allowlist.
CNYOS_OWNER_CONTROL_ENABLED=false
CNYOS_OWNER_DRIVE_ENABLED=false
CNYOS_OWNER_EMAILS=
CNYOS_OWNER_EXPECTED_PROJECT_REF=
CNYOS_OWNER_EXPECTED_NETLIFY_SITE_ID=
CNYOS_OWNER_EXPECTED_SITE_ORIGIN=
CNYOS_OWNER_CLINIC_CODES=

# Fast white-label presentation/auth overrides. These replace matching values
# in CLINICAL_OS_TENANT_CONFIG_JSON at build time without editing the JSON.
CLINICAL_OS_APP_NAME=
CLINICAL_OS_BRAND_SHORT_NAME=
CLINICAL_OS_BROWSER_TITLE=
CLINICAL_OS_BRAND_NAME_TH=
CLINICAL_OS_BRAND_NAME_EN=
CLINICAL_OS_PRODUCT_NAME=
CLINICAL_OS_BRAND_DESCRIPTOR=
CLINICAL_OS_BRAND_MARK=
CLINICAL_OS_BRAND_LOGO_URL=
CLINICAL_OS_AUTH_PROVIDER=google

# Server-only encrypted database backup. Keep both gates false until the
# isolated site has its own service account, encryption key, audited database
# assignment, encrypted export proof and isolated restore proof. Never expose
# these values to browser code, build output or auth-config.js.
BACKUP_ENABLED=false
# Staging/production read the encrypted service-account document from a
# site-scoped Netlify Blob. The small wrap key is Functions-only and must be
# different from the backup encryption and internal dispatch secrets.
GOOGLE_DRIVE_SERVICE_ACCOUNT_WRAP_KEY_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_WRAP_KEY_BASE64=
# Exact dedicated Google identity authenticated into the Blob binding/AAD.
GOOGLE_DRIVE_EXPECTED_SERVICE_ACCOUNT_EMAIL=
BACKUP_ENCRYPTION_KEY_BASE64=
GOOGLE_DRIVE_EXPECTED_ROOT_FOLDER_ID=
BACKUP_ENVIRONMENT=
BACKUP_DEPLOYMENT_ID=
BACKUP_EXPECTED_SUPABASE_PROJECT_REF=
BACKUP_EXPECTED_NETLIFY_SITE_ID=
BACKUP_EXPECTED_SITE_ORIGIN=
# Required for every staging control/backup deployment. This must be the
# same customer's distinct Production Supabase origin and is used only as a
# denylist boundary; never substitute another customer's Production project.
BACKUP_PRODUCTION_SUPABASE_URL=
BACKUP_INTERNAL_DISPATCH_SECRET=
BACKUP_MAX_CLINICS_PER_RUN=10

# Explicit restore-test-only compatibility. Staging and production reject both
# this flag and raw JSON. Never put the JSON in Build scope.
GOOGLE_DRIVE_SERVICE_ACCOUNT_ALLOW_RESTORE_TEST_DIRECT_JSON=false
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# Narrow, server-only lookup used by the protected isolated-restore workflow.
# Keep disabled until one exact completed backup run exists and the protected
# GitHub environment has a distinct read-only Drive service account.
RESTORE_SOURCE_API_ENABLED=false
RESTORE_SOURCE_API_TOKEN_SHA256=
RESTORE_SOURCE_CLINIC_CODES=
RESTORE_SOURCE_EXPECTED_PRODUCTION_PROJECT_REF=

# Restore-test only: configure all five IDs together. Staging and production
# must resolve the five per-clinic/per-environment folders from the audited
# Supabase assignment; these variables are not their fallback destination.
GOOGLE_DRIVE_PATIENTS_FOLDER_ID=
GOOGLE_DRIVE_PRODUCTS_FOLDER_ID=
GOOGLE_DRIVE_PHARMACY_FOLDER_ID=
GOOGLE_DRIVE_TRANSACTIONS_FOLDER_ID=
GOOGLE_DRIVE_MANIFESTS_FOLDER_ID=

# Isolated authenticated staging. These values are consumed only by the
# protected manual staging workflow and local release verification scripts.
# The staging config must use a different Supabase project, clinic code, QR
# issuer and site origin from Production. Never commit real values.
CLINICAL_OS_STAGING_ACK=STAGING_ONLY
CLINICAL_OS_STAGING_CONFIG_JSON=
CLINICAL_OS_PRODUCTION_CONFIG_JSON=
STAGING_SITE_URL=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_TEST_EMAIL_DOMAIN=
STAGING_TEST_EMAIL_PREFIX=clinical-os-e2e
STAGING_TEST_PASSWORD=
STAGING_BROWSER_E2E=true
STAGING_SYNTHETIC_UAT_ACK=CREATE_SYNTHETIC_RECORDS
STAGING_EVIDENCE_DIR=artifacts/staging-e2e

# Protected isolated-restore workflow only. The raw token and reader service
# account belong in GitHub Environment secrets; the endpoint/environment/root
# belong in protected Environment variables. Never reuse a backup writer as
# the restore reader.
RESTORE_SOURCE_API_URL=
RESTORE_SOURCE_ENVIRONMENT=staging
RESTORE_SOURCE_API_TOKEN=
GOOGLE_DRIVE_RESTORE_READER_SERVICE_ACCOUNT_JSON=
