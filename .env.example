# Public identifier returned to the patient app; not a secret.
LINE_LIFF_ID=

# LINE Login channel used to verify the LIFF ID token audience.
LINE_LOGIN_CHANNEL_ID=

# Server-only values. Never copy these into auth-config.js or browser code.
PATIENT_IDENTITY_HMAC_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only encrypted database backup. The service account must be shared as
# Editor on the four destination folders; never expose these values to browser
# code or auth-config.js.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
BACKUP_ENCRYPTION_KEY_BASE64=
GOOGLE_DRIVE_PATIENTS_FOLDER_ID=
GOOGLE_DRIVE_PRODUCTS_FOLDER_ID=
GOOGLE_DRIVE_PHARMACY_FOLDER_ID=
GOOGLE_DRIVE_MANIFESTS_FOLDER_ID=
